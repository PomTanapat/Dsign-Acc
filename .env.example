# Postgres connection string used by Drizzle + Auth.js adapter
DATABASE_URL=postgres://user:password@localhost:5432/dsign_acc

# Auth.js v5
# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=replace-me-with-a-32-byte-random-string
# Public base URL of the app (no trailing slash). Required in production.
AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (https://resend.com/api-keys) — used for transactional email
RESEND_API_KEY=
EMAIL_FROM="Dsign Accounting <no-reply@dsignaccounting.com>"

# Phase 7 — guidance layer
# Where "Talk to us" requests are emailed. TODO(owner): confirm the inbox.
TALK_TO_US_EMAIL=
# Show amber "draft — pending CPA review" badges on glossary/explainer copy.
# Keep "true" in dev/staging; production launch requires every term signed
# off (draft:false) — see docs/specs/phase-7-implementation-plan.md D6.
NEXT_PUBLIC_SHOW_DRAFT_BADGES=true
